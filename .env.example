# JWT
JWT_ACCESS_SECRET='secret_access_key'
JWT_REFRESH_SECRET='secret_refresh_key'
JWT_ACCESS_EXPIRES_IN='15m'
JWT_REFRESH_EXPIRES_IN='7d'

# Verification code TTLs, in seconds
ADMIN_TRANSFER_TOKEN_EXPIRES_IN=300  # 5m
REGISTRATION_TOKEN_EXPIRES_IN=300  # 5m
RESET_TOKEN_EXPIRES_IN=300  # 5m
EMAIL_CHANGE_TOKEN_EXPIRES_IN=300  # 5m
PASSWORD_CHANGE_TOKEN_EXPIRES_IN=300  # 5m

# Verification resend cooldown, in seconds
VERIFICATION_CODE_RESEND_COOLDOWN=60  # 1m between registration/public reset code requests

# Verification lockouts after 5 incorrect codes, in seconds
REGISTRATION_VERIFICATION_LOCKOUT=180  # 3m
PASSWORD_RESET_VERIFICATION_LOCKOUT=180  # 3m
EMAIL_CHANGE_VERIFICATION_LOCKOUT=180  # 3m

# Login rate limiting
LOGIN_EMAIL_MAX_ATTEMPTS=5  # failed attempts per normalized email within the window
LOGIN_IP_MAX_ATTEMPTS=20  # failed attempts per IP within the window
LOGIN_RATE_LIMIT_WINDOW=300  # 5m fixed window, in seconds

# Public verification request rate limiting
PUBLIC_VERIFICATION_IP_MAX_REQUESTS=20  # registration/resend/public reset requests per IP
PUBLIC_VERIFICATION_IP_RATE_LIMIT_WINDOW=600  # 10m fixed window, in seconds

# General API rate limiting
AUTH_IP_MAX_REQUESTS=120  # all /api/auth/* requests per IP within the window
AUTH_RATE_LIMIT_WINDOW=60  # 1m fixed window, in seconds
API_IP_MAX_REQUESTS=600  # all API requests per IP within the window
API_RATE_LIMIT_WINDOW=60  # 1m fixed window, in seconds

# Redis
REDIS_HOST='localhost'
REDIS_PORT=6379

# Application
SERVER_PORT=5174
FRONTEND_URL='http://localhost:5173'

# HTTP / cookie security
# Local development defaults. In production behind HTTPS use REFRESH_COOKIE_SECURE=true.
# If frontend and API are cross-site, use REFRESH_COOKIE_SAME_SITE='none' together with Secure=true.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE='lax'
# false = do not trust proxy headers. Otherwise use an exact hop count or trusted IP/subnet.
# Do not use true because it trusts arbitrary forwarded client IP values.
TRUST_PROXY='false'

# PostgreSQL / TypeORM
DB_TYPE='postgres'
DB_HOST='localhost'
DB_PORT=5432
DB_NAME='DB_NAME'
DB_USERNAME='postgres'
DB_PASSWORD='DB_PASSWORD'
DB_TYPEORM_SYNC=true

# SMTP
SMTP_HOST='smtp.gmail.com'
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER='service@gmail.com'
SMTP_FROM='service@gmail.com'
SMTP_PASS='SMTP_PASS'

# Initial administrator migration only.
# These variables are read by CreateAdminUser migration and are not used
# to identify the current administrator during normal application runtime.
INITIAL_ADMIN_EMAIL='user@gmail.com'
INITIAL_ADMIN_PASSWORD='INITIAL_ADMIN_PASSWORD'
INITIAL_ADMIN_NICKNAME='INITIAL_ADMIN_NICKNAME'
